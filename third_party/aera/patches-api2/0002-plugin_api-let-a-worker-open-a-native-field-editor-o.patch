       if (!scene->session.Supports(plugin_api::kFeatureTextInput) || !scene->page_pending ||
diff --git a/aeraui/tests/plugin_api_session_test.cpp b/aeraui/tests/plugin_api_session_test.cpp
index 2bda519a..055ca18b 100644
--- a/aeraui/tests/plugin_api_session_test.cpp
+++ b/aeraui/tests/plugin_api_session_test.cpp
@@ -154,6 +154,13 @@ int main() {
   assert(session.Poll().at(0).kind == Kind::kSetDesktopKeyboard);
   assert(session.Send(Kind::kDesktopKeyboardInset, 0, 270));
   assert(ReceiveHost(pair[1]).value == 270);
+  static_assert(kFeatureDesktopTextInput == (1U << 13));
+  static_assert(static_cast<uint32_t>(Kind::kEditTextInput) == 30);
+  static_assert(static_cast<uint32_t>(Kind::kDismissTextInput) == 31);
+  SendWorker(pair[1], Kind::kEditTextInput, 101);
