                                  message.flags & plugin_api::kInputMultiline);
       break;
     }
+    case plugin_api::Kind::kEditTextInput:
+    case plugin_api::Kind::kDismissTextInput: {
+      if (!scene->session.Supports(plugin_api::kFeatureDesktopTextInput) ||
+          !message.request_id || message.value || message.flags ||
+          message.title[0] || message.text[0]) {
+        SetStatus(scene, "Plugin sent an invalid text editor request");
+        scene->session.Close(); break;
+      }
+      const bool editing = scene->input_overlay && scene->input_id == message.request_id;
+      // Dismissing an editor that already closed is a no-op: each accepted
+      // edit has exactly one TEXT_INPUT_RESULT.
+      if (message.kind == plugin_api::Kind::kDismissTextInput) {
+        if (editing) CloseTextInput(scene, false);
+        break;
+      }
+      if (!editing && !OpenTextInput(scene, message.request_id, true))
+        scene->session.Send(plugin_api::Kind::kTextInputResult, message.request_id, 0,
