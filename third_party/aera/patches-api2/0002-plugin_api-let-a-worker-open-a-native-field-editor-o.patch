+  const auto editor = session.Poll();
+  assert(editor.size() == 2 && editor[1].kind == Kind::kDismissTextInput);
   close(pair[1]);
   session.Close();
   assert(!session.Supports(kOptionalFeatures));
@@ -165,6 +172,8 @@ int main() {
   assert(ReceiveHost(pair[1]).flags == (3 | kFeatureActivities));
   (void)ReceiveHost(pair[1]);
   assert(!session.Supports(kFeatureBackground));
+  SendWorker(pair[1], Kind::kEditTextInput, 101);
+  assert(session.Poll().empty() && !session.Connected());
   close(pair[1]);
   session.Close();
 
diff --git a/aeraui/tests/plugin_runtime_ui_test.cpp b/aeraui/tests/plugin_runtime_ui_test.cpp
index 8bd14dda..5ef746c6 100644
--- a/aeraui/tests/plugin_runtime_ui_test.cpp
+++ b/aeraui/tests/plugin_runtime_ui_test.cpp
@@ -293,6 +293,45 @@ void TestPluginRuntime(lv_obj_t *host_screen) {
   OpenTextInput(scene, 104); assert(!lv_textarea_get_one_line(scene->input_editor));
   lv_textarea_set_text(scene->input_editor, "first\nsecond");
   CloseTextInput(scene, true); assert(std::string(receive(peer).text) == "first\nsecond");
+  // A worker-driven editor over the desktop suspends the desktop's input.
+  {
+    scene->callback = [](Action, void *) {};
+    Message desktop; desktop.kind = Kind::kOpenDesktop; desktop.request_id = 310;
+    HandleMessage(scene, desktop); assert(scene->desktop_open);
+    assert(receive(peer).kind == Kind::kDesktopReady);
+    assert(receive(peer).kind == Kind::kDesktopKeyboardInset);
+    assert(PluginDesktopHandleKey('a', 1));
+    Message edit; edit.kind = Kind::kEditTextInput; edit.request_id = 101;
+    HandleMessage(scene, edit);
+    assert(scene->input_overlay && scene->input_id == 101 && ModalVisible(page));
+    assert(!PluginDesktopHandleKey('b', 1) && !PluginDesktopHandlePointer(0, 100, 100, true));
+    HandleMessage(scene, edit);  // Already open: still one result.
+    Message dismiss = edit; dismiss.kind = Kind::kDismissTextInput;
+    HandleMessage(scene, dismiss);
+    auto dismissed = receive(peer);
+    assert(dismissed.kind == Kind::kTextInputResult && dismissed.request_id == 101 &&
+           dismissed.flags == kInputCancelled && !scene->input_overlay);
+    HandleMessage(scene, dismiss);  // Nothing open: no reply.
+    assert(!PluginDesktopHandlePointer(0, 100, 100, false) && PluginDesktopHandleKey('b', 1));
+    HandleMessage(scene, edit);
+    lv_textarea_set_text(scene->input_editor, "\xc3\x9c" "ber");
+    CloseTextInput(scene, true);
+    auto submitted = receive(peer);
+    assert(submitted.request_id == 101 && submitted.flags == kInputSubmitted &&
+           submitted.value == 4 && std::string(submitted.text) == "\xc3\x9c" "ber");
+    edit.request_id = 999; HandleMessage(scene, edit);
+    auto refused = receive(peer);
+    assert(refused.request_id == 999 && refused.flags == kInputError && !scene->input_overlay);
+    // Destroying the editor with its view also restores desktop input.
+    edit.request_id = 101; HandleMessage(scene, edit);
+    assert(!PluginDesktopHandleKey('c', 1));
+    lv_obj_delete(scene->input_overlay);
+    assert(receive(peer).flags == kInputCancelled && !scene->input_overlay);
+    assert(PluginDesktopHandleKey('c', 1));
+    ClosePluginDesktop(); scene->desktop_open = false; scene->callback = nullptr;
+    lv_tick_inc(20); lv_timer_handler();
+    Message extra; assert(recv(peer, &extra, sizeof(extra), MSG_DONTWAIT) < 0);
+  }
   Message update; update.kind = Kind::kUpdateTextInput; update.request_id = 101;
   snprintf(update.text, sizeof(update.text), "From plugin"); HandleMessage(scene, update);
   assert(field->value == "From plugin");
