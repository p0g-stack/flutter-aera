@@ -26,11 +26,12 @@ enum Features : uint32_t {
   kFeatureTextInput = 1U << 10,
   kFeatureFilePicker = 1U << 11,
   kFeatureDesktopIntegration = 1U << 12,
+  kFeatureDesktopTextInput = 1U << 13,
 };
 constexpr uint32_t kOptionalFeatures = kFeatureBackground | kFeatureActivities |
     kFeatureRichPresentation | kFeaturePackageReview | kFeatureReadablePresentation |
     kFeatureDesktop | kFeatureDesktopResolution | kFeatureClipboard | kFeatureTextInput |
-    kFeatureFilePicker | kFeatureDesktopIntegration;
+    kFeatureFilePicker | kFeatureDesktopIntegration | kFeatureDesktopTextInput;
 constexpr uint32_t kFeatureRequestMagic = 0xA2E20000U;
 
 enum class Kind : uint32_t {
@@ -63,6 +64,8 @@ enum class Kind : uint32_t {
   kTextInputPlaceholder = 27,
   kPickFile = 28,
   kSetDesktopKeyboard = 29,
+  kEditTextInput = 30,
+  kDismissTextInput = 31,
   kHelloAck = 64,
   kAction,
   kLifecycle,
@@ -166,7 +169,7 @@ inline bool StringsValid(const Message &message) {
          memchr(message.text, '\0', sizeof(message.text)) != nullptr;
 }
 inline bool WorkerKind(Kind kind) {
-  return kind >= Kind::kHello && kind <= Kind::kSetDesktopKeyboard;
+  return kind >= Kind::kHello && kind <= Kind::kDismissTextInput;
 }
 inline bool HostKind(Kind kind) {
   return kind >= Kind::kHelloAck && kind <= Kind::kDesktopKeyboardInset;
@@ -177,6 +180,8 @@ inline uint32_t KindFeature(Kind kind) {
   switch (kind) {
     case Kind::kSetDesktopKeyboard:
     case Kind::kDesktopKeyboardInset: return kFeatureDesktopIntegration;
+    case Kind::kEditTextInput:
+    case Kind::kDismissTextInput: return kFeatureDesktopTextInput;
     default: return 0;
   }
 }
