+void KeyboardEvent(lv_event_t *event) {
+  auto *state=static_cast<PlayScene *>(lv_event_get_user_data(event));
+  const auto code=lv_event_get_code(event);
+  if(code==LV_EVENT_READY||code==LV_EVENT_CANCEL) {
+    // Integration: Done submits like Return before the keyboard hides.
+    if(code==LV_EVENT_READY&&state->integration) {
+      state->Send(PLAY_KEY,0xff0d,1);state->Send(PLAY_KEY,0xff0d,0);
