+uint32_t PluginDesktopKeysym(const char *label,bool unicode) {
+  if(!label)return 0;
+  if(!strcmp(label,LV_SYMBOL_BACKSPACE))return 0xff08;
+  if(!strcmp(label,LV_SYMBOL_NEW_LINE))return 0xff0d;
+  if(!strcmp(label,LV_SYMBOL_LEFT))return 0xff51;
+  if(!strcmp(label,LV_SYMBOL_RIGHT))return 0xff53;
+  if(strlen(label)==1&&label[0]>=32&&label[0]<=126)return static_cast<unsigned char>(label[0]);
+  if(!unicode)return 0;
+  uint32_t index=0;
+  const uint32_t code=lv_text_encoded_next(label,&index);
+  if(!index||label[index]!='\0')return 0;
+  if(code>=0xa0&&code<=0xff)return code;  // Latin-1 keysyms equal the code point.
+  // Private-use code points are LVGL's symbol glyphs, not text.
+  if(code<=0xff||(code>=0xd800&&code<=0xdfff)||(code>=0xe000&&code<=0xf8ff)||code>0x10ffff)
+    return 0;
+  return 0x01000000U|code;
+}
