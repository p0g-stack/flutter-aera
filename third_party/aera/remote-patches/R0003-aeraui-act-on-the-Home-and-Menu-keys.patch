From 35ebc5a923584d30372a117515a59bc5c7567abf Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 1 Oct 2026 22:13:42 +0000
Subject: [PATCH] aeraui: act on the Home and Menu keys

AERA Remote's Home and Menu buttons send KEY_HOMEPAGE and KEY_MENU, and
its virtual device advertises both, but recovery handled only Power,
Volume and Back, so a remote viewer could reach Home or Recents only with
the bottom-edge swipe. Make Home do what the swipe does (dismiss Recents,
show Home) and Menu open or close Recents when gesture navigation is on.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J6XhHxrkhAcXmkzHMeCnVz
---
 aeraui/core/engine.cpp           | 18 ++++++++++++++++++
 aeraui/core/runner.cpp           |  6 ++++++
 aeraui/include/aeraui/engine.hpp |  5 +++++
 3 files changed, 29 insertions(+)

diff --git a/aeraui/core/engine.cpp b/aeraui/core/engine.cpp
index 19f039d..55f8a5e 100644
--- a/aeraui/core/engine.cpp
+++ b/aeraui/core/engine.cpp
@@ -638,6 +638,22 @@ public:
     }
   }
 
+  void HomeKey() {
+    if (lock_overlay_ != nullptr || !backend_ready_ || fastboot_mode_ ||
+        decryption_active_)
+      return;
+    if (recents_overlay_ != nullptr) DismissRecents();
+    if (!on_home_) ShowHome();
+  }
+
+  void MenuKey() {
+    if (lock_overlay_ != nullptr || !backend_ready_ || fastboot_mode_ ||
+        decryption_active_ || !RecoveryPreference(Preference::kRecents))
+      return;
+    if (recents_overlay_ != nullptr) DismissRecents();
+    else ShowRecents(false);
+  }
+
   void NavigateBack(bool feedback = true, bool held = false) {
     // A held Back leaving a pixel plugin passes over everything the plugin
     // would take: whatever it does with Back, or if it stopped answering,
@@ -3586,6 +3602,8 @@ uint32_t Engine::RunFrame() { return impl_->RunFrame(); }
 Action Engine::TakeAction() { return impl_->TakeAction(); }
 void Engine::NavigateHome() { impl_->NavigateHome(); }
 void Engine::NavigateBack(bool held) { impl_->NavigateBack(true, held); }
+void Engine::HomeKey() { impl_->HomeKey(); }
+void Engine::MenuKey() { impl_->MenuKey(); }
 void Engine::SetBackendReady() { impl_->SetBackendReady(); }
 void Engine::BeginDecryption(int credential_type, bool file_based, int user_id,
                              int pattern_grid_size) {
diff --git a/aeraui/core/runner.cpp b/aeraui/core/runner.cpp
index 1b5d8fd..6432e1e 100644
--- a/aeraui/core/runner.cpp
+++ b/aeraui/core/runner.cpp
@@ -362,6 +362,12 @@ bool HandleEvent(Engine& engine, InteractionBoost& performance,
         hardware.back_pressed_at_ms = 0;
         engine.NavigateBack(held);
     }
+    if (event.code == KEY_HOMEPAGE && event.value == 0 && !hardware.screen_off) {
+        engine.HomeKey();
+    }
+    if (event.code == KEY_MENU && event.value == 0 && !hardware.screen_off) {
+        engine.MenuKey();
+    }
     return false;
 }
 
diff --git a/aeraui/include/aeraui/engine.hpp b/aeraui/include/aeraui/engine.hpp
index 07a2ff0..2bc65f6 100644
--- a/aeraui/include/aeraui/engine.hpp
+++ b/aeraui/include/aeraui/engine.hpp
@@ -123,6 +123,11 @@ class Engine final {
     static constexpr uint32_t kBackHoldMs = 500;
     void NavigateHome();
     void NavigateBack(bool held = false);
+    // The Home and Menu keys (AERA Remote's buttons, KEY_HOMEPAGE and
+    // KEY_MENU) do what the bottom-edge swipe does: Home, and Recents when
+    // gesture navigation is on.
+    void HomeKey();
+    void MenuKey();
 
     // Unlocks workflows after recovery has finished fstab, mount and decrypt
     // initialization. The boot renderer can run before this point.
