diff --git a/aeraui/core/engine.cpp b/aeraui/core/engine.cpp
index 5577a74..aee366d 100644
--- a/aeraui/core/engine.cpp
+++ b/aeraui/core/engine.cpp
@@ -660,8 +660,13 @@ public:
     else ShowRecents(false);
   }
 
-  void NavigateBack(bool feedback = true) {
-    if (feedback) RecoveryVibrate(Haptic::kTouch);
+  void NavigateBack(bool feedback = true, bool held = false) {
+    // A held Back leaving a pixel plugin passes over everything the plugin
+    // would take: whatever it does with Back, or if it stopped answering,
+    // the user can always leave it.
+    const bool leave_plugin = held && PixelPluginActive();
+    if (feedback || leave_plugin)
+      RecoveryVibrate(leave_plugin ? Haptic::kAction : Haptic::kTouch);
     if (recents_overlay_ != nullptr) {
       DismissRecents();
       return;
@@ -669,7 +674,10 @@ public:
     if (lock_overlay_ != nullptr || !backend_ready_ || decryption_active_ ||
         operation_running_ || nas_running_ || plugin_running_)
       return;
-    if (widgets::DismissModal(lv_screen_active())) return;
+    if (leave_plugin)
+      __android_log_print(ANDROID_LOG_INFO, kLogTag,
+                          "Back held; leaving the pixel plugin");
+    else if (widgets::DismissModal(lv_screen_active())) return;
     if (fastboot_mode_) {
       if (current_tool_ == Action::kFormatData) ShowFastboot();
       return;
@@ -875,6 +883,13 @@ public:
           0, swipe_right_edge_ ? swipe_start_x_ - pointer_.x
                                : pointer_.x - swipe_start_x_);
       swipe_max_inward_ = std::max(swipe_max_inward_, inward);
+      // How long the contact has stayed past the depth that accepts Back:
+      // released after kBackHoldMs there, it is a held Back.
+      const int32_t visible_width = landscape_ ? height_ : width_;
+      if (inward < visible_width / 6)
+        swipe_held_since_ = 0;
+      else if (swipe_held_since_ == 0)
+        swipe_held_since_ = std::max<uint32_t>(1, MonotonicMilliseconds());
       UpdateEdgeSwipe(inward);
       return;
     }
@@ -888,7 +903,9 @@ public:
       const bool accepted = swipe_max_inward_ >= visible_width / 6 &&
                             swipe_max_inward_ > vertical * 2;
       const bool right_edge = swipe_right_edge_;
-      FinishEdgeSwipe(accepted);
+      const bool held = accepted && swipe_held_since_ != 0 &&
+          MonotonicMilliseconds() - swipe_held_since_ >= Engine::kBackHoldMs;
+      FinishEdgeSwipe(accepted, held);
       if (accepted) {
         if (pointer_device_ != nullptr) lv_indev_reset(pointer_device_, nullptr);
         RecoveryVibrate(Haptic::kTouch);
@@ -2988,8 +3005,10 @@ private:
     self->gesture_indicator_ = nullptr;
     self->gesture_depth_ = 0;
     const bool navigate_back = self->gesture_navigate_back_;
+    const bool held = self->gesture_held_;
     self->gesture_navigate_back_ = false;
-    if (navigate_back) self->NavigateBack(false);
+    self->gesture_held_ = false;
+    if (navigate_back) self->NavigateBack(false, held);
   }
 
   void BeginEdgeSwipe(bool right_edge) {
@@ -3043,11 +3062,14 @@ private:
     lv_obj_invalidate(gesture_indicator_);
   }
 
-  void FinishEdgeSwipe(bool accepted) {
+  void FinishEdgeSwipe(bool accepted, bool held = false) {
     swipe_active_ = false;
+    swipe_held_since_ = 0;
     gesture_navigate_back_ = accepted;
+    gesture_held_ = accepted && held;
     if (gesture_indicator_ == nullptr) {
       gesture_navigate_back_ = false;
+      gesture_held_ = false;
       return;
     }
     lv_anim_delete(this, SetEdgeGestureDepth);
@@ -3065,7 +3087,9 @@ private:
 
   void CancelEdgeSwipe() {
     swipe_active_ = false;
+    swipe_held_since_ = 0;
     gesture_navigate_back_ = false;
+    gesture_held_ = false;
     lv_anim_delete(this, SetEdgeGestureDepth);
     if (gesture_indicator_ != nullptr) {
       lv_obj_delete(gesture_indicator_);
@@ -3343,6 +3367,7 @@ private:
   int32_t swipe_start_y_ = 0;
   int32_t swipe_last_y_ = 0;
   int32_t swipe_max_inward_ = 0;
+  uint32_t swipe_held_since_ = 0;
   int32_t gesture_depth_ = 0;
   int32_t recents_swipe_start_x_ = 0;
   int32_t recents_swipe_last_x_ = 0;
@@ -3395,6 +3420,7 @@ private:
   bool swipe_active_ = false;
   bool swipe_right_edge_ = false;
   bool gesture_navigate_back_ = false;
+  bool gesture_held_ = false;
   bool recents_swipe_active_ = false;
   bool suspended_ = false;
   bool fastboot_mode_ = false;
@@ -3421,7 +3447,7 @@ void Engine::AbandonForTerminalAction() { impl_.release(); }
 uint32_t Engine::RunFrame() { return impl_->RunFrame(); }
 Action Engine::TakeAction() { return impl_->TakeAction(); }
 void Engine::NavigateHome() { impl_->NavigateHome(); }
-void Engine::NavigateBack() { impl_->NavigateBack(); }
+void Engine::NavigateBack(bool held) { impl_->NavigateBack(true, held); }
 void Engine::HomeKey() { impl_->HomeKey(); }
 void Engine::MenuKey() { impl_->MenuKey(); }
 void Engine::SetBackendReady() { impl_->SetBackendReady(); }
